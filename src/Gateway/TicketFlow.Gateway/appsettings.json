{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "events": {
        "ClusterId": "events",
        "Match": { "Path": "/api/events/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "bookings": {
        "ClusterId": "bookings",
        "Match": { "Path": "/api/bookings/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "events": {
        "Destinations": {
          "events-api": { "Address": "http://localhost:5039/" }
        }
      },
      "bookings": {
        "Destinations": {
          "booking-api": { "Address": "http://localhost:5182/" }
        }
      }
    }
  }
}
